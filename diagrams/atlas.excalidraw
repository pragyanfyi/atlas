      "created": 1795800000000,
      "link": null,
      "locked": false,
      "text": "An over-the-air update swaps this bundle without a store build.",
      "originalText": "An over-the-air update swaps this bundle without a store build.",
      "fontSize": 30,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
